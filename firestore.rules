rules_version = '2';

// ──────────────────────────────────────────────────────────────────────────
// חוקי אבטחה ל-Firestore — וידאו דיזיין CRM
//
// המצב לפני: ברירת המחדל ברוב הפרויקטים מאפשרת לכל אחד באינטרנט לקרוא ולשנות
// את כל הנתונים (מפתח ה-Firebase גלוי בקוד הלקוח — וזה תקין רק כשהחוקים סגורים).
//
// החוקים כאן דורשים שהמשתמש יהיה מחובר (כולל התחברות אנונימית שהאפליקציה
// מבצעת אוטומטית). כך משתמש אקראי בלי האפליקציה לא יכול לגשת לנתונים.
//
// חשוב: זו רמת אבטחה בסיסית. היא לא מבדילה בין משתמשים שונים. לאבטחה מלאה
// (הרשאות פר-משתמש) צריך לעבור ל-Firebase Authentication אמיתי (אימייל/סיסמה).
// ──────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // כל הקריאות והכתיבות דורשות התחברות (אנונימית או אחרת)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
